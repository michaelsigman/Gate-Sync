# --- Safety ---
# DRY_RUN defaults to true. Set to exactly "false" to actually write to gates.
DRY_RUN=true

# --- Proptia (gate 1: 4 properties, HTML portal) ---
PROPTIA_USERNAME=
PROPTIA_PASSWORD=
PROPTIA_LOGIN_PATH=/en-us/login/

# --- GoAccessControl (gate 2: 1 property, REST API) ---
GOACCESS_USERNAME=
GOACCESS_PASSWORD=
# Supabase publishable anon key (the `apikey` header on the login request).
# Safe to ship; grants nothing on its own. Capture from the login HAR if needed.
GOACCESS_ANON_KEY=

# --- Reservations: ArrivalPilot (Hospitable-synced) ---
# Read-only feed (arrival-pilot-dev function gateSyncFeed). When AP_FEED_URL is set it is the
# source; RESERVATION_SOURCE=hostfully forces the old path.
AP_FEED_URL=https://us-west1-arrival-pilot-dev.cloudfunctions.net/gateSyncFeed
GATE_SYNC_TOKEN=
RESERVATION_SOURCE=

# --- Automatic adding (src/automation.js) ---
# Writes happen only when AUTO_ADD is exactly "true", DRY_RUN is exactly "false", AND the
# property's "mode" in gate_property_map.json is "live" (off | preview | live; missing = off).
# Otherwise each sweep logs what it WOULD add.
AUTO_ADD=false
SWEEP_CRON=*/15 * * * *
SWEEP_DAYS_AHEAD=14
SWEEP_MAX_ADDS=25
MAX_ADD_ATTEMPTS=3
# Results back to ArrivalPilot (gateSyncReport). Defaults to AP_FEED_URL with gateSyncFeed -> gateSyncReport.
AP_REPORT_URL=
# ArrivalPilot calls POST /api/hooks/gate-submitted (Bearer GATE_SYNC_TOKEN) when a guest submits.

# --- Failure alerts (email via SendGrid) ---
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=mike@poolautopilot.com
DASHBOARD_URL=

# --- Gate-read cache / history ---
GATE_CACHE_TTL_MS=900000
STORE_PATH=

# --- Hostfully (legacy fallback) ---
HOSTFULLY_API_KEY=
HOSTFULLY_AGENCY_UID=

# --- Server ---
PORT=3000
UI_TOKEN=
# ALLOW_OPEN_UI=true only for local dev; without UI_TOKEN the API refuses.
# ENABLE_DEBUG_WRITES=true enables the /api/debug/*-add-test endpoints (real passes!).

# CRON_SCHEDULE (old daily run) is replaced by SWEEP_CRON
RUN_TOKEN=

# --- Mapping helper (one-time) ---
GOACCESS_RESIDENT_ID=0fac128a-2849-460f-8deb-8c41df7bf559
GOACCESS_VISITOR_TYPE_ID=cd2ad43d-2abd-46fe-aee7-6a23069ac2ff
